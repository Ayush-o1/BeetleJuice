{
  "name": "beetlejuice",
  "version": "1.1.0",
  "description": "BeetleJuice — settlement reconciliation and break management for payment operations (synthetic-data simulation).",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20.12"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
    "migrate": "node scripts/migrate.js",
    "db:create": "node scripts/create-db.js",
    "user:create": "node scripts/create-user.js",
    "demo:generate": "node scripts/generate-demo-data.js",
    "demo:scenarios": "node scripts/generate-scenarios.js",
    "demo:reset": "node scripts/demo-reset.js",
    "bench": "node scripts/benchmark.js",
    "screenshots": "node scripts/capture-screenshots.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/**/*.test.js\"",
    "lint": "node scripts/check-syntax.js"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright-core": "^1.65.0"
  },
  "author": "Ayush-o1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ayush-o1/BeetleJuice.git"
  },
  "keywords": [
    "reconciliation",
    "settlements",
    "payments",
    "fintech",
    "postgresql",
    "express"
  ]
}
