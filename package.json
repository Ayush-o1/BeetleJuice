{
  "name": "beetlejuice",
  "version": "1.0.0",
  "description": "BeetleJuice — settlement reconciliation and break management for payment operations (synthetic-data simulation).",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
    "migrate": "node scripts/migrate.js",
    "db:create": "node scripts/create-db.js",
    "user:create": "node scripts/create-user.js",
    "demo:generate": "node scripts/generate-demo-data.js",
    "demo:reset": "node scripts/demo-reset.js",
    "bench": "node scripts/benchmark.js",
    "test": "node --test --test-concurrency=1 test/unit test/integration test/e2e",
    "test:unit": "node --test test/unit",
    "test:integration": "node --test --test-concurrency=1 test/integration",
    "test:e2e": "node --test --test-concurrency=1 test/e2e",
    "lint": "node scripts/check-syntax.js"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0"
  }
}
