# Copy to .env and adjust. Never commit .env.
# The app reads these via src/config/index.js and fails fast when a value is invalid.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL connection string. Local Homebrew installs usually need no password.
DATABASE_URL=postgres://localhost:5432/beetlejuice_dev

# Uploaded CSV bytes are stored here (outside public/). Content-addressed by SHA-256.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_ROWS=50000

# Sessions are server-side (PostgreSQL). Cookies are Secure automatically in production.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
# Set to true when running behind a TLS-terminating reverse proxy.
TRUST_PROXY=false

# Reconciliation worker. Runs inside the web process unless disabled.
WORKER_IN_PROCESS=true
WORKER_POLL_MS=1500
RUN_MAX_ATTEMPTS=3
RUN_LEASE_SECONDS=120

# Demo tooling guard: scripts/demo-reset.js refuses to run unless this is "true",
# NODE_ENV is not production, and the database name ends in _dev, _demo or _test.
ALLOW_DEMO_RESET=false
